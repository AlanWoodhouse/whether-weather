<script>

 function updateTime() {

 const now = new Date();

 const romeTime = new Intl.DateTimeFormat("en-GB", {

 timeZone: "Europe/Rome",

 hour: "2-digit",

 minute: "2-digit",

 second: "2-digit"

 }).format(now);

 document.getElementById("local-time").textContent = romeTime;

 }

 updateTime();

 setInterval(updateTime, 1000);

</script>

