<style>
  body {
    background: url('/images/londonday.jpg') no-repeat center center fixed;
    background-size: cover;
  }
  .section {background-color: rgba(255,255,255,0.1); border-radius: 12px; }
</style>

<script>
    function updateTime() {
        const now = new Date();
        const londonTime = new Intl.DateTimeFormat("en-GB", {
            timeZone: "Europe/London",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit"
        }).format(now);
        document.getElementById("local-time").textContent = londonTime;
    }
    updateTime();
    setInterval(updateTime, 1000);
</script>

<div class="columns is-vcentered">
  <div class="column is-6">
    <h1 class="title is-1">London</h1>
    <p class="subtitle is-4"><span class="local-time">Local Time: <span id="local-time"></span></span></p>
    <div class="has-text-centered">
      <span class="icon weather-icon has-text-warning"><i class="fas fa-cloud fa-2x"></i></span>
      <p class="title is-2 mt-2">Cloudy</p>
    </div>
  </div>
  <div class="column is-6">
    <div class="black-box p-5 has-text-centered">
      <p class="is-size-5">Right Now</p>
      <p class="title is-1 has-text-white">9°C</p>
      <p class="subtitle is-5 has-text-grey-light">18 km/h <i class="fas fa-wind"></i></p>
    </div>
  </div>
</div>

