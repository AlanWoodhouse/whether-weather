<script>

 function updateTime() {

 const now = new Date();

 const vilniusTime = new Intl.DateTimeFormat("en-GB", {

 timeZone: "Europe/Vilnius",

 hour: "2-digit",

 minute: "2-digit",

 second: "2-digit"

 }).format(now);

 document.getElementById("local-time").textContent = vilniusTime;

 }

 updateTime();

 setInterval(updateTime, 1000);

</script>

