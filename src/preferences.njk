<h1 class="title is-2">User Settings</h1>

<div class="columns">
  <div class="column is-6">
    <div class="box" style="background:#e8f4fc;">
      <h2 class="title is-4">Favourite Cities</h2>
      <div class="field is-flex is-justify-content-space-between py-2"><span>Berlin</span><input type="checkbox" class="fav" data-city="berlin"></div>
      <div class="field is-flex is-justify-content-space-between py-2"><span>London</span><input type="checkbox" class="fav" data-city="london"></div>
      <div class="field is-flex is-justify-content-space-between py-2"><span>Paris</span><input type="checkbox" class="fav" data-city="paris"></div>
      <div class="field is-flex is-justify-content-space-between py-2"><span>Rome</span><input type="checkbox" class="fav" data-city="Rome"></div>
      <div class="field is-flex is-justify-content-space-between py-2"><span>Vilnius</span><input type="checkbox" class="fav" data-city="vilnius"></div>
      <div class="field is-flex is-justify-content-space-between py-2"><span>Zagreb</span><input type="checkbox" class="fav" data-city="zagreb"></div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const saved = JSON.parse(localStorage.getItem('favs') || '{}');
  document.querySelectorAll('.fav').forEach(cb => {
    cb.checked = !!saved[cb.dataset.city];
    cb.addEventListener('change', () => {
      saved[cb.dataset.city] = cb.checked;
      localStorage.setItem('favs', JSON.stringify(saved));
    });
  });
});
</script>
